+++ b/backend/Dockerfile
@@ -11,4 +11,10 @@ RUN npm run build
 
 EXPOSE 4000
 
-CMD ["sh", "-c", "npx prisma migrate deploy && npm run start:prod"]
+# ملحوظة مهمة: المشروع ده لسه معندوش أي migration متسجل في backend/prisma/migrations
+# (المجلد أصلاً مش موجود في الريبو)، فـ "prisma migrate deploy" وحدها كانت
+# بترجع "No migration found" من غير ما تعمل حاجة، والداتابيز فاضية تمامًا،
+# فأي API call كان بيطيح بخطأ "relation does not exist". دلوقتي بنستخدم
+# "prisma db push" عشان تنشئ/تزامن الجداول من schema.prisma مباشرة أول ما
+# الكونتينر يشتغل، وبعدين تشغيل الـ seed (كله upsert فآمن يتنفذ كذا مرة).
+CMD ["sh", "-c", "npx prisma db push --skip-generate --accept-data-loss && npm run prisma:seed && npm run start:prod"]
diff --git a/backend/src/counts/counts.service.ts b/backend/src/counts/counts.service.ts
index 8a603b4..8f9c1b0 100644
--- a/backend/src/counts/counts.service.ts
+++ b/backend/src/counts/counts.service.ts
@@ -1,8 +1,12 @@
 import { BadRequestException, Injectable, NotFoundException } from '@nestjs/common';
+import { Prisma } from '@prisma/client';
 import { PrismaService } from '../prisma/prisma.service';
 import { StockService } from '../stock/stock.service';
 import { CreateStockCountDto } from './dto/count.dto';
 
+const UNIQUE_CONSTRAINT_VIOLATION = 'P2002';
+const MAX_REFERENCE_RETRIES = 5;
+
 @Injectable()
 export class CountsService {
   constructor(private prisma: PrismaService, private stockService: StockService) {}
@@ -13,8 +17,6 @@ export class CountsService {
   }
 
   async create(dto: CreateStockCountDto) {
-    const reference = await this.generateReference();
-
     const products = await this.prisma.product.findMany({
       where: {
         isActive: true,
@@ -34,17 +36,36 @@ export class CountsService {
       lines.push({ productId: product.id, expectedQty });
     }
 
-    return this.prisma.stockCount.create({
-      data: {
-        reference,
-        warehouseId: dto.warehouseId,
-        locationId: dto.locationId,
-        categoryId: dto.categoryId,
-        status: 'IN_PROGRESS',
-        lines: { create: lines },
-      },
-      include: { lines: { include: { product: true } } },
-    });
+    // reference بتتحسب من عدد سجلات stock_counts الحالي (COUNT + 1)، ولو
+    // طلبين جو بنفس اللحظة (مثلاً دبل كليك أو مستخدمين مختلفين) ممكن الاتنين
+    // ياخدوا نفس الرقم ويصطدموا بـ unique constraint على reference. بنعيد
+    // المحاولة بمرجع جديد بدل ما نرمي خطأ 500 للمستخدم.
+    for (let attempt = 0; attempt < MAX_REFERENCE_RETRIES; attempt++) {
+      const reference = await this.generateReference();
+      try {
+        return await this.prisma.stockCount.create({
+          data: {
+            reference,
+            warehouseId: dto.warehouseId,
+            locationId: dto.locationId,
+            categoryId: dto.categoryId,
+            status: 'IN_PROGRESS',
+            lines: { create: lines },
+          },
+          include: { lines: { include: { product: true } } },
+        });
+      } catch (err) {
+        const isReferenceCollision =
+          err instanceof Prisma.PrismaClientKnownRequestError &&
+          err.code === UNIQUE_CONSTRAINT_VIOLATION &&
+          (err.meta?.target as string[] | undefined)?.includes('reference');
+        if (!isReferenceCollision || attempt === MAX_REFERENCE_RETRIES - 1) {
+          throw err;
+        }
+      }
+    }
+    // Unreachable — but keeps TypeScript happy about a guaranteed return.
+    throw new BadRequestException('تعذر إنشاء رقم مرجعي فريد للجرد - Could not generate a unique count reference');
   }
 
   async findAll() {
