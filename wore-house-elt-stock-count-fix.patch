+  // كانت من غير أي decorator، فـ ValidationPipe العام (whitelist: true) كان
+  // بيشيلها من الـ body قبل ما توصل للـ service خالص -> الكمية المجرودة
+  // كانت دايمًا بتتخزن null حتى لو المستخدم بعتها فعليًا.
+  @IsNumber()
+  @Min(0)
   countedQty: number;
