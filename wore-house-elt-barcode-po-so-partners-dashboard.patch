+  @IsNumber()
+  @IsPositive()
+  quantity: number;
+
+  @IsNumber()
+  unitPrice: number;
+}
+
+export class CreateSalesOrderDto {
+  @IsString()
+  customerId: string;
+
+  @IsString()
+  warehouseId: string;
+
+  @IsOptional()
+  @IsString()
+  notes?: string;
+
+  @IsArray()
