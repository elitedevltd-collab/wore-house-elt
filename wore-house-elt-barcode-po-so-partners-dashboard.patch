+                {warehouses?.map((w: any) => <option key={w.id} value={w.id}>{w.name}</option>)}
+              </select>
+            </Field>
+          </div>
+
+          <div className="flex items-center justify-between mt-4 mb-2">
+            <div className="text-sm font-medium">{t('الأصناف', 'Lines')}</div>
